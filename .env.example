# ── REQUIRED ──────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string

# Your public URL (no trailing slash)
BASE_URL=https://your-app.onrender.com

# ── STRIPE (required for payments) ────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...

# Get from: Stripe → Developers → Webhooks → your endpoint → Signing Secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ── CLOUDINARY (required for persistent image uploads) ────
# Free account at: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── OPTIONAL ───────────────────────────────────────────────
# Your root domain (used for subdomain routing)
APP_DOMAIN=sitesnap.app

# Server port (Render sets this automatically)
PORT=3000
