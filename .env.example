# Copy to .env for local development. In production set these in Railway.

# ── CORE ──────────────────────────────────────────────────
NODE_ENV=development
# Generate with: openssl rand -hex 32 (the app refuses to start in production without it)
JWT_SECRET=replace-with-a-long-random-string
# Public URL, no trailing slash
BASE_URL=http://localhost:3000
# Root domain used for subdomains and to recognise SiteSnap's own hosts
APP_DOMAIN=site-snap.app
PORT=3000

# ── DATABASE ──────────────────────────────────────────────
# Railway sets this when a Postgres service is attached. Without it the app
# uses SQLite on local disk, and on Railway every redeploy deletes all sites.
DATABASE_URL=
# Local SQLite file name (development and tests only)
SQLITE_PATH=sitesnap.db

# ── PAYMENTS: PAYPAL ──────────────────────────────────────
PAYMENT_PROVIDER=paypal
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# ID of the webhook pointing at /api/paypal/webhook (see README for the events)
PAYPAL_WEBHOOK_ID=
# ID of the $12/month Pro plan
PAYPAL_PRO_PLAN_ID=

# ── PAYMENTS: STRIPE (legacy, off while PAYMENT_PROVIDER=paypal) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── IMAGES: CLOUDINARY ────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── EMAIL: RESEND ─────────────────────────────────────────
# Both are needed to switch on password reset, email confirmation,
# contact forms on customer sites and admin alerts.
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. SiteSnap <hello@site-snap.app>
RESET_FROM_EMAIL=
# Where sign-up, dispute and failed-payment alerts go
SIGNUP_NOTIFY_EMAIL=
# Public contact address on the site and legal pages, and reply-to on emails
SUPPORT_EMAIL=support@site-snap.app

# ── CUSTOM DOMAINS: CLOUDFLARE FOR SAAS (preferred) ───────
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# Host customers point their CNAME at
CF_CNAME_TARGET=
# Shared secret between the Cloudflare Worker and the app
EDGE_SECRET=

# ── CUSTOM DOMAINS: RAILWAY API (fallback) ────────────────
# Workspace token from https://railway.com/account/tokens
RAILWAY_API_TOKEN=
RAILWAY_PROJECT_ID=
RAILWAY_ENVIRONMENT_ID=
RAILWAY_SERVICE_ID=
# Used only when neither of the above is set up
CNAME_TARGET=

# ── ADMIN ─────────────────────────────────────────────────
# Password for /admin
ADMIN_PASSWORD=
# The account allowed to open /api/_diag
ADMIN_EMAIL=

# ── MONITORING AND ANALYTICS (optional) ───────────────────
SENTRY_DSN=
# Turns on Plausible (cookie-free) analytics on the landing page, e.g. site-snap.app
PLAUSIBLE_DOMAIN=
