# ── REQUIRED ──────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string

# Your public URL (no trailing slash)
BASE_URL=https://your-app.onrender.com

# ── STRIPE (required for payments) ────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...

# Get from: Stripe → Developers → Webhooks → your endpoint → Signing Secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ── CLOUDINARY (required for persistent image uploads) ────
# Free account at: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── RAILWAY (for automatic customer custom domains) ───────
# Without these, custom domains still save but each one has to be added
# by hand in the Railway dashboard before it will actually work.
#
# Token:  https://railway.com/account/tokens
#         Pick your WORKSPACE in the dropdown — a workspace token is scoped
#         to that workspace only. Avoid an account token ("No workspace"),
#         which can touch everything you own.
# IDs:    Open your project in Railway and press Cmd/Ctrl + K → copy
#         project / service / environment ID.
RAILWAY_API_TOKEN=
RAILWAY_PROJECT_ID=
RAILWAY_ENVIRONMENT_ID=
RAILWAY_SERVICE_ID=

# ── OPTIONAL ───────────────────────────────────────────────
# Your root domain (used for subdomain routing)
APP_DOMAIN=sitesnap.app

# Where customer CNAME records should point. Must be the host that actually
# serves the app. Only used as a fallback when the Railway vars above are unset.
CNAME_TARGET=sitesnap-production-b50b.up.railway.app

# Server port (Render sets this automatically)
PORT=3000
